ENVIRONMENT=development

# Postgres (usa "postgres" como host cuando corras via docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/athletic_analysis

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lista separada por comas (no JSON): ver Settings.cors_origins_list en core/config.py
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Carga de video (Fase 3)
MAX_VIDEO_SIZE_MB=500
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# Estimacion de pose: MediaPipe detecta personas usando el video real.
# Descarga el modelo antes de procesar videos: python -m scripts.download_pose_model
# Usa "mock" solo para pruebas visuales; no detecta personas reales.
POSE_ESTIMATOR_BACKEND=mediapipe
MEDIAPIPE_MODEL_PATH=models/pose_landmarker_full.task
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_PRESENCE_CONFIDENCE=0.65
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5

# Calculo de metricas y calibracion (Fase 10): "basic"/"linear" (Fase 6,
# heuristicas simples) o "biomechanical"/"homography" (Fase 10, formulas
# reales). Ninguno de los dos requiere tocar codigo al cambiarlo.
METRICS_CALCULATOR_BACKEND=basic
CALIBRATION_BACKEND=linear
TRACK_LANE_WIDTH_M=1.22

LOG_LEVEL=INFO
